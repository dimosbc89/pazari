// Cloudflare Workers (static assets). Cloudflare runs `npm run build`, then `npx wrangler deploy`.
// "single-page-application" serves index.html for every route (/gr/products, ...).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pazari",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
