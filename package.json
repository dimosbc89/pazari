{
  "name": "tagora",
  "private": true,
  "version": "0.1.0",
  "description": "Tagora: comparison shopping service (CSS) web app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node scripts/build-plugin-zip.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "demo:data": "node scripts/generate-demo-data.mjs",
    "brand": "node scripts/build-brand.mjs",
    "feed:import": "node scripts/import.ts",
    "typesense:push": "node scripts/typesense-push.mjs",
    "dev:api": "wrangler dev --port 8787",
    "dev:mocks": "node dev/mock-shops.mjs & node dev/mock-typesense.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy",
    "plugin:zip": "node scripts/build-plugin-zip.mjs",
    "plugin:test": "php plugins/woocommerce/tests/catalog-test.php"
  },
  "dependencies": {
    "@fontsource-variable/commissioner": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fast-xml-parser": "^5.11.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
