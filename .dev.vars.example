# Local development values for `npm run dev:api` (copy to .dev.vars, which is git-ignored).
# Works with the test shops and test search index in dev/ (npm run dev:mocks).
ENVIRONMENT=development
SITE_URL=http://localhost:8787
ADMIN_EMAILS=admin@example.com
# Optional: also mirror products to a Typesense index (npm run dev:mocks starts a test one)
# TYPESENSE_HOST=localhost
# TYPESENSE_PORT=8108
# TYPESENSE_PROTOCOL=http
# TYPESENSE_ADMIN_KEY=dev
# Leave these empty locally: sign-in links are then shown on screen instead of emailed.
RESEND_API_KEY=
MAIL_FROM=
# The Tagora app for Shopify, against the stand-in Shopify (node plugins/shopify/tests/mock-shopify.mjs).
# Test values only; the real Client ID is in wrangler.jsonc and the real secret is a Cloudflare secret.
SHOPIFY_API_KEY=test-client-id
SHOPIFY_API_SECRET=test-secret
SHOPIFY_TEST_ORIGIN=http://localhost:8790
