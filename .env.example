# Search backend: "local" uses the demo catalogue in public/demo/products.json.
# "typesense" queries your Typesense cluster (see README: Connect a real catalogue).
VITE_SEARCH_BACKEND=local

# Typesense (search-only API key; never put an admin key here, it ships to the browser)
VITE_TYPESENSE_HOST=xxx.a1.typesense.net
VITE_TYPESENSE_PORT=443
VITE_TYPESENSE_PROTOCOL=https
VITE_TYPESENSE_SEARCH_KEY=
VITE_TYPESENSE_COLLECTION=products

# Google Tag Manager container. Loaded only after the visitor accepts analytics cookies.
VITE_GTM_ID=

# Used only by scripts/typesense-push.mjs (never by the browser)
TYPESENSE_ADMIN_KEY=
